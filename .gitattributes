# Normalización de saltos de línea para todo el equipo
# Fuerza LF (estándar Unix/Flutter/Dart) en todos los SOs

# Regla general: todos los archivos de texto usan LF
* text=auto eol=lf

# Código Dart
*.dart text eol=lf

# Configuración y metadatos
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Archivos binarios (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
